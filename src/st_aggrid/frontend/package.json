{
  "name": "st-aggrid-frontend",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run clean && bun run typecheck && bun run build:frontend:production",
    "build:frontend:production": "NODE_ENV=production vite build",
    "clean": "rm -rf build",
    "dev": "NODE_ENV=development vite build --watch",
    "test:security": "bun test test/security.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun fmt --check . && bun lint --max-warnings 0 && bun run typecheck && bun test"
  },
  "packageManager": "bun@1.4.2",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@fontsource/source-sans-pro": "^5.3.0",
    "@streamlit/component-v2-lib": "^0.2.0",
    "ag-charts-enterprise": "^14.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-enterprise": "36.2.0",
    "ag-grid-react": "36.2.0",
    "date-fns": "^4.4.0",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/lodash": "^4.17.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
