{
  "name": "st-aggrid-frontend",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run typecheck && npm run build:frontend:production",
    "build:frontend:production": "cross-env NODE_ENV=production vite build",
    "clean": "rimraf build",
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "test:security": "rimraf .test-build && tsc --target ES2020 --module ESNext --moduleResolution bundler --strict --skipLibCheck --outDir .test-build src/utils.ts src/utils/csvExport.ts src/streamlitThemeVars.ts && node --test test/security.test.mjs && rimraf .test-build",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@fontsource/source-sans-pro": "^5.3.0",
    "@streamlit/component-v2-lib": "^0.2.0",
    "ag-charts-enterprise": "^13.3.0",
    "ag-grid-community": "^35.3.0",
    "ag-grid-enterprise": "35.3.0",
    "ag-grid-react": "35.3.0",
    "date-fns": "^4.4.0",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
